# Copy to .env (never committed) and fill in. Every setting can also be a real environment variable.

# Path to the Stockfish binary. Empty = look for "stockfish" on PATH.
STOCKFISH_PATH=
# Analysis depth and parallelism (one engine process per worker).
ENGINE_DEPTH=16
ENGINE_THREADS=1
ENGINE_WORKERS=8

# SQLite file. Default: data/trainer.db inside the project.
DATABASE_PATH=

# chess.com asks API clients for an identifying User-Agent (add a contact if you deploy publicly).
CHESSCOM_USER_AGENT=chess-trainer/0.1

# Google AI Studio key for explanations (phase 6).
GEMINI_API_KEY=
